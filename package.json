{
  "name": "rackplanner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "sync-rf": "node scripts/sync-rf-data.mjs ../rf-scan-editor",
    "test:3d": "esbuild tests/collision3d.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/collision3d.mjs --log-level=warning && node node_modules/.cache/collision3d.mjs",
    "test:lib": "esbuild tests/library.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/library.mjs --log-level=warning && node node_modules/.cache/library.mjs",
    "test": "npm run -s test:lib && npm run -s test:cases && npm run -s test:cables && npm run -s test:3d && npm run -s test:i18n && npm run -s test:edit3d",
    "test:cables": "esbuild tests/cables.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/cables.mjs --log-level=warning && node node_modules/.cache/cables.mjs",
    "test:cases": "esbuild tests/cases.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/cases.mjs --log-level=warning && node node_modules/.cache/cases.mjs",
    "test:edit3d": "esbuild tests/edit3d.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/edit3d.mjs --log-level=warning && node node_modules/.cache/edit3d.mjs",
    "test:i18n": "esbuild tests/i18n.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/i18n.mjs --log-level=warning && node node_modules/.cache/i18n.mjs"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svg2pdf.js": "^2.2.4",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
